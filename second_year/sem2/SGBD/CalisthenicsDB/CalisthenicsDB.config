<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="CalisthenicsShopConnection"
            connectionString="Data Source=.;Initial Catalog=CalisthenicsShop;Integrated Security=True;TrustServerCertificate=True"
            providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ParentTable" value="Type" />
		<add key="ChildTable" value="Item" />
		<add key="ParentTablePK" value="Tid" />
		<add key="ChildTableFK" value="Tid" />
	</appSettings>
</configuration>